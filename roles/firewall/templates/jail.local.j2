[DEFAULT]
backend   = systemd
banaction = nftables-multiport
banaction_allports = nftables-allports
# Never ban the private LAN served by the Pi
ignoreip  = 127.0.0.1/8 ::1 {{ lan_address }}
bantime   = 1h
findtime  = 10m
maxretry  = 5
# Repeat offenders: ever longer bans (up to 1 week)
bantime.increment = true
bantime.maxtime   = 1w

[sshd]
enabled = true
port    = {{ ssh_port }}
