#cloud-config
# Generated by bootstrap.yml: no named user, root access by SSH key only.
hostname: {{ hostname }}
manage_etc_hosts: true
timezone: {{ timezone }}
users: []
disable_root: false
ssh_pwauth: false
apt:
  preserve_sources_list: true
  conf: |
    Acquire {
      Check-Date "false";
    };
bootcmd:
  - [ systemctl, mask, --now, userconfig.service ]
write_files:
  - path: /root/.ssh/authorized_keys
    owner: root:root
    permissions: "0600"
    defer: false
    content: |
{% for key in ssh_authorized_keys %}
      {{ key }}
{% endfor %}
runcmd:
  - [ systemctl, enable, --now, ssh ]
  # Bring up the hotspot LAN at first boot, so the Pi is reachable at
  # {{ lan_address.split("/")[0] }} from the TP-Link wifi. Same settings as the network role.
  - [ nmcli, connection, add, type, ethernet, ifname, {{ lan_interface }}, con-name, {{ lan_connection }}, ipv4.method, shared, ipv4.addresses, "{{ lan_address }}", ipv4.never-default, "yes", ipv6.method, disabled ]
  - [ nmcli, connection, up, {{ lan_connection }} ]
